{
  "info": {
    "_postman_id": "bh-ss-api-collection",
    "name": "Birhane Hiwot Sunday School - QA API",
    "description": "QA Postman collection for the Birhane Hiwot Sunday School Attendance Management System.\n\n## Setup\n1. Import this collection and `Birhane-Hiwot.postman_environment.json`.\n2. Update environment variables with valid credentials and `baseUrl`.\n3. Run **Auth → Get CSRF Token**, then **Auth → Login (Credentials)** before protected endpoints.\n4. Postman stores session cookies automatically after login.\n\n## Roles\n- Super Admin\n- HR Admin\n- Education Admin\n- Attendance Facilitator\n- Education Facilitator\n- Teacher\n\n## Notes\n- Most API routes do not enforce auth at the route level; the UI uses NextAuth middleware for pages.\n- Facilitators, teachers, admin-users, and education-facilitators routes check JWT role.\n- Student creation enforces role rules via `userRole` and `userEmail` in the request body.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{ "key": "baseUrl", "value": "http://localhost:3000" }],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Get CSRF Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.environment.set('csrfToken', json.csrfToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/csrf"
          }
        },
        {
          "name": "Login (Credentials)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login succeeds', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 302]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "csrfToken",
                  "value": "{{csrfToken}}",
                  "type": "text"
                },
                {
                  "key": "email",
                  "value": "{{superAdminEmail}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{superAdminPassword}}",
                  "type": "text"
                },
                { "key": "json", "value": "true", "type": "text" },
                {
                  "key": "callbackUrl",
                  "value": "{{baseUrl}}/login",
                  "type": "text"
                }
              ]
            },
            "url": "{{baseUrl}}/api/auth/callback/credentials"
          }
        },
        {
          "name": "Get Session",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/session"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "csrfToken",
                  "value": "{{csrfToken}}",
                  "type": "text"
                },
                {
                  "key": "callbackUrl",
                  "value": "{{baseUrl}}/login",
                  "type": "text"
                }
              ]
            },
            "url": "{{baseUrl}}/api/auth/signout"
          }
        }
      ]
    },
    {
      "name": "Setup",
      "item": [
        {
          "name": "Create Super Admin (one-time)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Super Admin\",\n  \"email\": \"{{superAdminEmail}}\",\n  \"password\": \"{{superAdminPassword}}\",\n  \"confirm\": \"CREATE_SUPER_ADMIN\"\n}"
            },
            "url": "{{baseUrl}}/api/setup/super-admin"
          }
        }
      ]
    },
    {
      "name": "Students",
      "item": [
        {
          "name": "List Students",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/students?grade={{grade}}&academicYear={{academicYear}}&limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students"],
              "query": [
                { "key": "grade", "value": "{{grade}}" },
                { "key": "academicYear", "value": "{{academicYear}}" },
                { "key": "limit", "value": "50" },
                { "key": "sex", "value": "Male", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Student by Unique ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/students?uniqueId={{studentUniqueId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students"],
              "query": [{ "key": "uniqueId", "value": "{{studentUniqueId}}" }]
            }
          }
        },
        {
          "name": "Get Student by Mongo ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/students/{{studentId}}"
          }
        },
        {
          "name": "Create Student (Super Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.environment.set('studentId', json._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Unique_ID\": \"{{studentUniqueId}}\",\n  \"First_Name\": \"Test\",\n  \"Father_Name\": \"Student\",\n  \"Grandfather_Name\": \"QA\",\n  \"Mothers_Name\": \"Mother\",\n  \"Christian_Name\": \"Gabriel\",\n  \"DOB_Date\": \"15\",\n  \"DOB_Month\": \"05\",\n  \"DOB_Year\": \"2010\",\n  \"Age\": 15,\n  \"Sex\": \"Male\",\n  \"Phone_Number\": \"0911000000\",\n  \"Class\": \"Regular\",\n  \"Occupation\": \"Student\",\n  \"School\": \"ሀና\",\n  \"Address\": \"ሲቪል ሰርቪስ አካባቢ\",\n  \"Academic_Year\": \"{{academicYear}}\",\n  \"Grade\": \"{{grade}}\",\n  \"Classification\": \"Regular\",\n  \"userRole\": \"Super Admin\"\n}"
            },
            "url": "{{baseUrl}}/api/students"
          }
        },
        {
          "name": "Create Student (Attendance Facilitator)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Unique_ID\": \"BH-FAC-001\",\n  \"First_Name\": \"Facilitator\",\n  \"Father_Name\": \"Created\",\n  \"Grandfather_Name\": \"Student\",\n  \"Mothers_Name\": \"Mother\",\n  \"Christian_Name\": \"Michael\",\n  \"DOB_Date\": \"01\",\n  \"DOB_Month\": \"01\",\n  \"DOB_Year\": \"2011\",\n  \"Age\": 14,\n  \"Sex\": \"Female\",\n  \"Phone_Number\": \"0911000001\",\n  \"Class\": \"Regular\",\n  \"Occupation\": \"Student\",\n  \"Address\": \"ሲቪል ሰርቪስ አካባቢ\",\n  \"Academic_Year\": \"{{academicYear}}\",\n  \"Grade\": \"{{grade}}\",\n  \"Classification\": \"Regular\",\n  \"userRole\": \"Attendance Facilitator\",\n  \"userEmail\": \"{{attendanceFacilitatorEmail}}\"\n}"
            },
            "url": "{{baseUrl}}/api/students"
          }
        },
        {
          "name": "Update Student (PUT)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Phone_Number\": \"0911223344\",\n  \"Occupation\": \"Student\"\n}"
            },
            "url": "{{baseUrl}}/api/students/{{studentId}}"
          }
        },
        {
          "name": "Update Student Photo (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"photo_data_url\": \"data:image/jpeg;base64,\"\n}"
            },
            "url": "{{baseUrl}}/api/students/{{studentId}}"
          }
        },
        {
          "name": "Generate QR Code (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"generateQR\": true\n}"
            },
            "url": "{{baseUrl}}/api/students/{{studentId}}"
          }
        },
        {
          "name": "Check Duplicate Student",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"First_Name\": \"Test\",\n  \"Father_Name\": \"Student\",\n  \"Grandfather_Name\": \"QA\",\n  \"Mothers_Name\": \"Mother\",\n  \"Sex\": \"Male\"\n}"
            },
            "url": "{{baseUrl}}/api/students/check-duplicate"
          }
        },
        {
          "name": "Get Student Count by Grades",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grades\": [\"{{grade}}\"],\n  \"academicYear\": \"{{academicYear}}\"\n}"
            },
            "url": "{{baseUrl}}/api/students/count"
          }
        },
        {
          "name": "Get Total Students",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/students/total"
          }
        },
        {
          "name": "Get Student QR Image",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/students/{{studentId}}/qr"
          }
        },
        {
          "name": "Get Student Payments",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/students/{{studentId}}/payments"
          }
        },
        {
          "name": "Delete Student",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{studentId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/students"
          }
        }
      ]
    },
    {
      "name": "Attendance",
      "item": [
        {
          "name": "List Attendance",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/attendance?date={{attendanceDate}}&grade={{grade}}&academicYear={{academicYear}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "attendance"],
              "query": [
                { "key": "date", "value": "{{attendanceDate}}" },
                { "key": "grade", "value": "{{grade}}" },
                { "key": "academicYear", "value": "{{academicYear}}" },
                {
                  "key": "studentId",
                  "value": "{{studentId}}",
                  "disabled": true
                },
                { "key": "limit", "value": "100", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Attendance Summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/attendance?date={{attendanceDate}}&grade={{grade}}&academicYear={{academicYear}}&summary=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "attendance"],
              "query": [
                { "key": "date", "value": "{{attendanceDate}}" },
                { "key": "grade", "value": "{{grade}}" },
                { "key": "academicYear", "value": "{{academicYear}}" },
                { "key": "summary", "value": "true" }
              ]
            }
          }
        },
        {
          "name": "Mark Attendance (Bulk Upsert)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"{{attendanceDate}}\",\n  \"attendance\": [\n    {\n      \"studentId\": \"{{studentId}}\",\n      \"date\": \"{{attendanceDate}}\",\n      \"present\": true,\n      \"hasPermission\": false,\n      \"reason\": \"\",\n      \"markedBy\": \"Attendance Facilitator\"\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/attendance"
          }
        },
        {
          "name": "Get Student Attendance History",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/attendance/{{studentId}}"
          }
        },
        {
          "name": "Get Temp Attendance",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/attendance/temp?date={{attendanceDate}}&grade={{grade}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "attendance", "temp"],
              "query": [
                { "key": "date", "value": "{{attendanceDate}}" },
                { "key": "grade", "value": "{{grade}}" }
              ]
            }
          }
        }
      ]
    },
